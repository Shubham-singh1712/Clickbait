# =============================================================================
# CLICKBAIT Backend Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# NEVER commit the actual '.env' file or any private keys to version control.
# =============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# Database Connection (PostgreSQL with Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clickbait_db?schema=public"

# CORS Configuration
# Comma-separated list of allowed origins (e.g., http://localhost:3000,http://localhost:5173)
CORS_ORIGIN="http://localhost:3000"

# JWT Authentication Secrets (For Authorized Institution Portal)
# Generate a high-entropy secret in production (e.g., via `openssl rand -hex 64`)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d

# Cryptographic Key Placeholders (NEVER HARDCODE ACTUAL PRODUCTION PRIVATE KEYS)
# Institutional private keys must be loaded from HSM, KMS, or secure vault at runtime.
# This variable is for local test fixtures ONLY.
INSTITUTION_PRIVATE_KEY_TEST_FIXTURE=""

# Blockchain Provenance Registry (Interface Configuration)
# Supported providers: 'mock', 'ethereum', 'polygon', 'hyperledger'
BLOCKCHAIN_PROVIDER=mock
BLOCKCHAIN_RPC_URL=""
BLOCKCHAIN_CONTRACT_ADDRESS=""

# Secondary AI Risk Assessment Engine (Member 2 Service URL)
AI_RISK_ENGINE_URL="http://localhost:8000/api/analyze"
AI_RISK_ENGINE_API_KEY=""

# Logging Level (error, warn, info, http, debug)
LOG_LEVEL=info
